# 微信视频号发布 CDP 配置
# 若已运行 backend/scripts/start-wechat-channels-cdp-chrome.mjs，则保持默认值即可
WECHAT_CHANNELS_CDP_URL=http://127.0.0.1:9222
WECHAT_CHANNELS_CDP_PORT=9222
WECHAT_CHANNELS_PROFILE_DIR=./data/wechat-channels-profile

# 抖音创作者平台发布 CDP 配置
# 抖音与视频号使用各自独立的 profile，必须是独立的 CDP 实例（独立端口）
# 若已运行 backend/scripts/start-douyin-cdp-chrome.mjs，则保持默认值即可
DOUYIN_CDP_URL=http://127.0.0.1:9224
DOUYIN_CDP_PORT=9224
DOUYIN_PROFILE_DIR=./data/douyin-profile

# Puppeteer Chrome 路径（可选，默认会尝试系统 Chrome 和 remotion chrome）
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Optional. When omitted, a local 0600 key file is created beside the SQLite database.
# Use a stable 32-byte base64 or 64-character hex value in deployed environments.
AI_CONFIG_ENCRYPTION_KEY=
HOST=127.0.0.1
