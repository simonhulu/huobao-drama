# 微信视频号发布 CDP 配置
# 若已运行 backend/scripts/start-wechat-channels-cdp-chrome.mjs，则保持默认值即可
WECHAT_CHANNELS_CDP_URL=http://127.0.0.1:9222
WECHAT_CHANNELS_CDP_PORT=9222
WECHAT_CHANNELS_PROFILE_DIR=./data/wechat-channels-profile

# 抖音创作者平台发布 CDP 配置
# 抖音与视频号使用各自独立的 profile，必须是独立的 CDP 实例（独立端口）
# 若已运行 backend/scripts/start-douyin-cdp-chrome.mjs，则保持默认值即可
DOUYIN_CDP_URL=http://127.0.0.1:9224
DOUYIN_CDP_PORT=9224
DOUYIN_PROFILE_DIR=./data/douyin-profile

# Puppeteer Chrome 路径（可选，默认会尝试系统 Chrome 和 remotion chrome）
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Optional. When omitted, a local 0600 key file is created beside the SQLite database.
# Use a stable 32-byte base64 or 64-character hex value in deployed environments.
AI_CONFIG_ENCRYPTION_KEY=
HOST=127.0.0.1

# Optional LatentSync service for manual lip-sync experiments.
# Science production only prepends the fixed intro; no presenter window or LatentSync.
# The backend opens an SSH local forward to the remote 3090 service when
# LATENTSYNC_API_URL is not set. Keep the password only in backend/.env.
LATENTSYNC_SSH_HOST=hz01-ssh.gpuhome.cc
LATENTSYNC_SSH_PORT=30163
LATENTSYNC_SSH_USER=root
# LATENTSYNC_SSH_KEY=/absolute/path/to/.ssh/id_ed25519
# LATENTSYNC_SSH_PASSWORD=
LATENTSYNC_REMOTE_HOST=127.0.0.1
LATENTSYNC_REMOTE_PORT=8787
# LATENTSYNC_API_URL=http://127.0.0.1:8787
# Independent of the fixed intro: a stable close-up presenter reference.
# SCIENCE_PRESENTER_REFERENCE_PATH=/absolute/path/to/presenter-reference.mp4
# SCIENCE_PRESENTER_FRAMING=closeup
LATENTSYNC_INFERENCE_STEPS=40
LATENTSYNC_GUIDANCE_SCALE=1.5
LATENTSYNC_ENABLE_DEEPCACHE=false
LATENTSYNC_SEED=1247

# Science and history recreation share this remote writer and SSH credentials.
# Port 8788 is independent of the LatentSync API on 8787.
SCIENCE_WRITER_REMOTE_PORT=8788
SCIENCE_WRITER_MODEL=Qwen3.5-9B-Writing-DPO-i1-Q4_K_M
# Independent prose allowances; max_tokens includes prose plus thinking tokens.
# The deployed server uses --ctx-size 131072; input plus output must fit it.
# Changing these client limits does not resize the remote context window.
SCIENCE_WRITER_MAX_TOKENS=8192
HISTORY_WRITER_MAX_TOKENS=32768
# History uses bounded thinking; science keeps its existing fast paraphrase mode.
HISTORY_WRITER_ENABLE_THINKING=true
HISTORY_WRITER_THINKING_BUDGET_TOKENS=8192
SCIENCE_WRITER_ENABLE_THINKING=false
SCIENCE_WRITER_THINKING_BUDGET_TOKENS=1536
# SCIENCE_WRITER_API_URL=http://127.0.0.1:8788
# Optional SSH overrides: SCIENCE_WRITER_SSH_HOST, SCIENCE_WRITER_SSH_PORT,
# SCIENCE_WRITER_SSH_USER, SCIENCE_WRITER_SSH_KEY, SCIENCE_WRITER_SSH_PASSWORD.

# Shared text-provider admission across all backend processes using this database.
# Requests using the same endpoint and credential share capacity and 429 cooldown.
AI_TEXT_MAX_CONCURRENCY=2
AI_TEXT_ADMISSION_MAX_WAIT_MS=300000
# Optional; defaults to <DB_PATH>.ai-admission.db. All processes must use the same path.
# AI_TEXT_ADMISSION_DB_PATH=/absolute/path/to/private/ai-admission.db

# Speech recognition for history/science sources (separate from TTS).
# With QWEN_API_KEY set, defaults to qwen-audio-3.1-asr-flash-filetrans.
# Otherwise MiniMax credentials reuse the active audio config.
QWEN_API_KEY=
# Optional: qwen or minimax. Set minimax to keep using the existing ASR service.
# ASR_PROVIDER=qwen
# Optional: use your region/workspace endpoint; defaults to the Beijing DashScope API.
# QWEN_ASR_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1

# Cloud narration TTS (distinct from ASR and the local qwen3-tts provider).
# Uses QWEN_API_KEY, model qwen-audio-3.1-tts-flash, and model-specific Aliyun voices.
# QWEN_TTS_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1
# Clone a reference and activate narration after a successful preview:
# cd backend && node --env-file=.env --import=tsx scripts/setup-qwen-tts.ts /path/to/reference.mp4 20 20

# History script sourcing.
# Manual login and collection use the same dedicated persistent Chromium profile.
# Open it from the history-script page; do not reuse a publishing/ordinary Chrome port.
HISTORY_LOGIN_CDP_URL=http://127.0.0.1:9241
# Publishing-title rewriting uses qwen3.5-9b-writing-dpo@q2_k on this local server.
HISTORY_LM_STUDIO_URL=http://127.0.0.1:1234/v1
# Optional; mainland MiniMax's old TTS host defaults to this documented ASR host.
# HISTORY_MINIMAX_ASR_BASE_URL=https://api.minimax.cn
# Private downloader connection file is generated by the deployment helper.
# Default path: data/storage/history-source-downloader/connection.json at project root.

# 花生自动制作：专用可见 Chrome，首次从历史脚本页面打开并登录一次。
# 默认使用项目根目录 data/huasheng-browser-profile，不复用个人或发布浏览器。
HUASHENG_CDP_URL=http://127.0.0.1:9243
# Production creation uses the API first. Set browser for the original UI driver.
# HUASHENG_CREATION_DRIVER=browser
# HUASHENG_PROFILE_DIR=/absolute/path/to/private/huasheng-browser-profile
# HUASHENG_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Set to 1 to disable the worker in development/test processes.
# HISTORY_HUASHENG_WORKER_DISABLED=1

# Reuse the existing social-auto-upload installation; never invoke direct publish.
# Defaults: ~/.local/share/social-auto-upload and its .venv/bin/python.
# SOCIAL_AUTO_UPLOAD_ROOT=/absolute/path/to/social-auto-upload
# SOCIAL_AUTO_UPLOAD_PYTHON=/absolute/path/to/social-auto-upload/.venv/bin/python
SOCIAL_AUTO_UPLOAD_BAIJIAHAO_CDP=http://127.0.0.1:9225
SOCIAL_AUTO_UPLOAD_TENCENT_CDP=http://127.0.0.1:9222
# Checkpoints and the durable upload queue stay outside public static storage.
# SOCIAL_AUTO_UPLOAD_STATE_ROOT=/absolute/path/to/private/social-auto-upload-state
# HISTORY_SOCIAL_UPLOAD_WORKER_DISABLED=1

# Optional ICU uconv executable for ASR simplified/traditional and homophone matching.
# Without ICU, audio alignment retains strict text matching.
# HISTORY_ALIGNMENT_UCONV=/opt/homebrew/opt/icu4c/bin/uconv

# YouTube channel collection and media downloads share the same proxy.
# HISTORY_YOUTUBE_PROXY=http://127.0.0.1:7897
# HISTORY_YOUTUBE_YTDLP_BIN=/absolute/path/to/yt-dlp
# Optional authentication; an explicit cookie file takes precedence over browser extraction.
# HISTORY_YOUTUBE_COOKIES_FILE=/absolute/path/to/private/youtube-cookies.txt
# HISTORY_YOUTUBE_COOKIES_BROWSER=chrome
# Optional Python with yt-dlp installed, used by the YouTube login refresh action.
# HISTORY_YOUTUBE_PYTHON_BIN=/absolute/path/to/python3

# NBA workbench; its local API can run separately from active CBA production.
# NBA_PORT=5684
# NBA_NEWS_PROXY=http://127.0.0.1:7897
# Compatible torch/torchaudio, numpy and soundfile are required for arena separation.
# NBA_AUDIO_PYTHON=/absolute/path/to/audio-venv/bin/python
# NBA_DEMUCS_CACHE=/absolute/path/to/private/nba-model-cache
# Optional existing official model, validated by SHA-256 before use.
# NBA_DEMUCS_WEIGHTS=/absolute/path/to/hdemucs_high_trained.pt
# WHISPER_CLI=/absolute/path/to/whisper-cli
# WHISPER_MODEL=/absolute/path/to/ggml-small.bin
