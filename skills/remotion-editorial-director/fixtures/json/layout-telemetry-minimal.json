{
  "schemaVersion": "editorial://schema/layout-telemetry/v1",
  "operationId": "11111111-1111-4111-8111-111111111111",
  "target": {
    "profileId": "youtube-1080p",
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "frameCount": 2,
  "coordinateSpace": {
    "origin": "top_left",
    "geometryUnits": "normalized_output",
    "translationUnits": "output_pixels",
    "rotationUnits": "degrees_clockwise",
    "intervalSemantics": "zero_based_start_inclusive_end_exclusive"
  },
  "layers": [
    {
      "layerId": "cue:cue-title-001:root",
      "kind": "text",
      "interval": {
        "startFrame": 0,
        "endFrame": 2
      },
      "sampling": "per_frame",
      "sourceAsset": null,
      "runs": [
        {
          "startFrame": 0,
          "endFrame": 2,
          "sample": {
            "boundingBox": {
              "x": 0.1,
              "y": 0.1,
              "width": 0.8,
              "height": 0.2
            },
            "opacity": 1,
            "transform": {
              "translateX": 0,
              "translateY": 0,
              "scaleX": 1,
              "scaleY": 1,
              "rotation": 0
            },
            "transformOrigin": {
              "x": 0.5,
              "y": 0.5
            },
            "maskBounds": null,
            "decodeStatus": "not_applicable"
          }
        }
      ]
    }
  ]
}
