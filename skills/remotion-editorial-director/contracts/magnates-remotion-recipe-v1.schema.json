{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huobao.local/schemas/magnates-media-recipe-v1.json",
  "title": "Magnates-style Remotion editorial recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "durationInFrames", "fps", "shots"],
  "properties": {
    "schemaVersion": { "const": "magnates-remotion-recipe-v1" },
    "durationInFrames": { "type": "integer", "minimum": 1 },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "title": { "type": "string" },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/shot" }
    }
  },
  "$defs": {
    "transitionClass": {
      "enum": [
        "hard_cut",
        "dissolve",
        "blur_bridge",
        "matte_transition",
        "graphic_transition",
        "distortion",
        "ambiguous",
        "no_local_delta",
        "within_setup_change"
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": { "$ref": "#/$defs/transitionClass" },
        "frames": { "type": "integer", "minimum": 0, "maximum": 45 },
        "accent": { "type": "string" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["image", "video"] },
        "fit": { "enum": ["cover", "contain"] },
        "position": { "type": "string" },
        "filter": { "type": "string" }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset"],
      "properties": {
        "preset": { "enum": ["hold", "push_in", "pull_out", "pan_left", "pan_right", "tilt_up", "tilt_down", "whip"] },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "startScale": { "type": "number", "minimum": 1 },
        "endScale": { "type": "number", "minimum": 1 }
      }
    },
    "textCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "startFrame", "endFrame"],
      "properties": {
        "type": { "enum": ["text", "counter"] },
        "subject": { "type": "string", "minLength": 2, "not": { "enum": ["text", "shape", "layer"] } },
        "text": { "type": "string" },
        "startFrame": { "type": "integer", "minimum": 0 },
        "endFrame": { "type": "integer", "minimum": 1 },
        "entry": { "enum": ["none", "fade", "slide_up", "slide_left", "wipe", "type_on", "counter"] },
        "exit": { "enum": ["none", "fade", "slide_down"] },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": ["number", "string"] },
        "align": { "enum": ["left", "center", "right"] },
        "fontSize": { "type": "number", "minimum": 10, "maximum": 180 },
        "weight": { "type": "number", "minimum": 100, "maximum": 900 },
        "color": { "type": "string" },
        "accent": { "type": "string" },
        "prefix": { "type": "string" },
        "suffix": { "type": "string" },
        "unit": { "type": "string", "minLength": 1 },
        "period": { "type": "string", "minLength": 1 },
        "from": { "type": "number" },
        "to": { "type": "number" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 4 },
        "label": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              { "required": ["type"], "properties": { "type": { "const": "counter" } } },
              { "required": ["entry"], "properties": { "entry": { "const": "counter" } } }
            ]
          },
          "then": { "required": ["to", "unit", "period"] }
        }
      ]
    },
    "graphicCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject", "startFrame", "endFrame"],
      "properties": {
        "kind": { "enum": ["underline", "bar", "globe", "grid", "monitor", "divider", "badge"] },
        "subject": { "type": "string", "minLength": 2, "not": { "enum": ["text", "shape", "layer"] } },
        "startFrame": { "type": "integer", "minimum": 0 },
        "endFrame": { "type": "integer", "minimum": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 },
        "color": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "durationInFrames", "background"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "durationInFrames": { "type": "integer", "minimum": 1 },
        "background": { "$ref": "#/$defs/asset" },
        "semanticRole": { "enum": ["hook", "establishing", "mechanism", "comparison", "reversal", "crisis", "resolution"] },
        "camera": { "$ref": "#/$defs/camera" },
        "transitionIn": { "$ref": "#/$defs/transition" },
        "transitionOut": { "$ref": "#/$defs/transition" },
        "texts": { "type": "array", "items": { "$ref": "#/$defs/textCue" } },
        "graphics": { "type": "array", "items": { "$ref": "#/$defs/graphicCue" } },
        "tint": { "type": "string" },
        "grain": { "type": "number", "minimum": 0, "maximum": 1 },
        "sourceLabel": { "type": "string" }
      }
    }
  }
}
