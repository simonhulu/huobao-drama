{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial://schema/boundary-samples/v1",
  "title": "Editorial boundary samples",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "sourceHash", "detector", "intervals", "coverage"],
  "properties": {
    "schemaVersion": {"const": "editorial://schema/boundary-samples/v1"},
    "sourceId": {"$ref": "editorial://schema/common/v1#/$defs/stableId"},
    "sourceHash": {"$ref": "editorial://schema/common/v1#/$defs/sha256"},
    "detector": {"$ref": "#/$defs/detector"},
    "intervals": {"type": "array", "items": {"$ref": "#/$defs/interval"}},
    "coverage": {"$ref": "#/$defs/coverage"}
  },
  "$defs": {
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "configHash"],
      "properties": {
        "name": {"$ref": "editorial://schema/common/v1#/$defs/stableId"},
        "version": {"type": "string", "minLength": 1, "maxLength": 120},
        "configHash": {"$ref": "editorial://schema/common/v1#/$defs/sha256"}
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervalId", "kind", "startFrame", "endFrame", "score", "frameReferences"],
      "properties": {
        "intervalId": {"$ref": "editorial://schema/common/v1#/$defs/stableId"},
        "kind": {"enum": ["boundary", "stable"]},
        "startFrame": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "endFrame": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "frameReferences": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startFrame", "endFrame", "sampledFrames", "sourceFrames"],
      "properties": {
        "startFrame": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "endFrame": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sampledFrames": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "sourceFrames": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    }
  }
}
