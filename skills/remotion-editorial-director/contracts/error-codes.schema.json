{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial://schema/error-codes/v1",
  "title": "Editorial error code registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "errors"],
  "properties": {
    "registryVersion": {"const": 1},
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/errorDefinition"}
    }
  },
  "$defs": {
    "errorDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "category",
        "exitCode",
        "allowedStages",
        "defaultRetryable",
        "detailsPolicy"
      ],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        "category": {
          "enum": [
            "internal",
            "invalid_input",
            "protocol_mismatch",
            "asset_failure",
            "adapter_failure",
            "inspection_failure",
            "protocol_failure",
            "cancelled"
          ]
        },
        "exitCode": {"enum": [1, 2, 3, 4, 5, 6, 7, 130]},
        "allowedStages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ANY",
              "INTAKE_LOCKED",
              "SEMANTICS_READY",
              "BOUNDARIES_READY",
              "TECHNIQUES_CLASSIFIED",
              "RECIPE_DRAFTED",
              "RECIPE_VALIDATED",
              "ADAPTER_READY",
              "PROPS_BUILT",
              "RENDERED",
              "INSPECTED",
              "QA_PASSED"
            ]
          }
        },
        "defaultRetryable": {"type": "boolean"},
        "detailsPolicy": {"enum": ["redacted", "user_safe"]}
      }
    }
  }
}
