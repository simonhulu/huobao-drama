{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial://schema/magnates-remotion-recipe/v2",
  "title": "Magnates Remotion editorial recipe v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "durationInFrames", "fps", "shots"],
  "properties": {
    "schemaVersion": {"const": "magnates-remotion-recipe-v2"},
    "durationInFrames": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "fps": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
    "title": {"type": "string", "maxLength": 240},
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/shot"}
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    },
    "transitionClass": {
      "enum": [
        "hard_cut",
        "dissolve",
        "blur_bridge",
        "matte_transition",
        "graphic_transition",
        "distortion",
        "ambiguous",
        "no_local_delta",
        "within_setup_change"
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": {"$ref": "#/$defs/transitionClass"},
        "frames": {"type": "integer", "minimum": 0, "maximum": 45},
        "accent": {"$ref": "#/$defs/color"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId"],
      "properties": {
        "assetId": {"$ref": "#/$defs/stableId"},
        "fit": {"enum": ["cover", "contain"]},
        "position": {
          "enum": [
            "center",
            "top",
            "bottom",
            "left",
            "right",
            "top_left",
            "top_right",
            "bottom_left",
            "bottom_right"
          ]
        },
        "filter": {"enum": ["none", "monochrome", "warm", "cool", "high_contrast", "soft_blur"]}
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset"],
      "properties": {
        "preset": {
          "enum": ["hold", "push_in", "pull_out", "pan_left", "pan_right", "tilt_up", "tilt_down", "whip"]
        },
        "intensity": {"type": "number", "minimum": 0, "maximum": 1},
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": {"type": "number", "minimum": 0, "maximum": 1},
            "y": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "startScale": {"type": "number", "minimum": 1, "maximum": 4},
        "endScale": {"type": "number", "minimum": 1, "maximum": 4}
      }
    },
    "textCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "subject", "subjectId", "startFrame", "endFrame"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "type": {"enum": ["text", "counter"]},
        "subject": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160,
          "not": {"enum": ["text", "shape", "layer", "subject", "person", "company", "unknown", "tbd"]}
        },
        "subjectId": {"$ref": "#/$defs/stableId"},
        "text": {"type": "string", "maxLength": 4000},
        "startFrame": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "endFrame": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "entry": {"enum": ["none", "fade", "slide_up", "slide_left", "wipe", "type_on", "counter"]},
        "exit": {"enum": ["none", "fade", "slide_down"]},
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "align": {"enum": ["left", "center", "right"]},
        "fontSize": {"type": "number", "minimum": 10, "maximum": 180},
        "weight": {"type": "integer", "minimum": 100, "maximum": 900, "multipleOf": 100},
        "color": {"$ref": "#/$defs/color"},
        "accent": {"$ref": "#/$defs/color"},
        "prefix": {"type": "string", "maxLength": 40},
        "suffix": {"type": "string", "maxLength": 40},
        "metricId": {"$ref": "#/$defs/stableId"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 40},
        "period": {"type": "string", "minLength": 1, "maxLength": 80},
        "from": {"type": "number"},
        "to": {"type": "number"},
        "decimals": {"type": "integer", "minimum": 0, "maximum": 4},
        "label": {"type": "string", "maxLength": 160}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "counter"}}, "required": ["type"]},
          "then": {"required": ["metricId", "to", "unit", "period"]}
        },
        {
          "if": {"properties": {"type": {"const": "text"}}, "required": ["type"]},
          "then": {"required": ["text"]}
        }
      ]
    },
    "graphicCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "subject", "subjectId", "startFrame", "endFrame"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "kind": {"enum": ["underline", "bar", "globe", "grid", "monitor", "divider", "badge"]},
        "subject": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160,
          "not": {"enum": ["text", "shape", "layer", "subject", "person", "company", "unknown", "tbd"]}
        },
        "subjectId": {"$ref": "#/$defs/stableId"},
        "startFrame": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "endFrame": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "color": {"$ref": "#/$defs/color"},
        "secondaryColor": {"$ref": "#/$defs/color"},
        "label": {"type": "string", "maxLength": 160}
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "durationInFrames", "background", "semanticRole"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "durationInFrames": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "background": {"$ref": "#/$defs/asset"},
        "semanticRole": {"enum": ["hook", "establishing", "mechanism", "comparison", "reversal", "crisis", "resolution"]},
        "camera": {"$ref": "#/$defs/camera"},
        "transitionIn": {"$ref": "#/$defs/transition"},
        "transitionOut": {"$ref": "#/$defs/transition"},
        "texts": {"type": "array", "items": {"$ref": "#/$defs/textCue"}},
        "graphics": {"type": "array", "items": {"$ref": "#/$defs/graphicCue"}},
        "tint": {"$ref": "#/$defs/color"},
        "grain": {"type": "number", "minimum": 0, "maximum": 1},
        "sourceLabel": {"type": "string", "maxLength": 160}
      }
    }
  }
}
