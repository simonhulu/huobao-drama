{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial://schema/inspect-report/v1",
  "title": "Editorial adapter inspection report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "media",
    "renderManifestHash",
    "layoutTelemetry",
    "frameCount",
    "decodeStatus",
    "streams",
    "assetDecodeResults",
    "warnings",
    "inspectedAt"
  ],
  "properties": {
    "schemaVersion": {"const": "editorial://schema/inspect-report/v1"},
    "operationId": {"type": "string", "format": "uuid"},
    "media": {"$ref": "#/$defs/fileReference"},
    "renderManifestHash": {"$ref": "editorial://schema/common/v1#/$defs/sha256"},
    "layoutTelemetry": {"$ref": "#/$defs/fileReference"},
    "frameCount": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "decodeStatus": {"enum": ["decoded", "failed"]},
    "streams": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stream"}},
    "assetDecodeResults": {"type": "array", "items": {"$ref": "#/$defs/assetDecode"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
    "inspectedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "editorial://schema/common/v1#/$defs/absolutePath"},
        "sha256": {"$ref": "editorial://schema/common/v1#/$defs/sha256"}
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "kind", "codec", "durationSeconds"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 1024},
        "kind": {"enum": ["video", "audio"]},
        "codec": {"type": "string", "minLength": 1, "maxLength": 80},
        "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "minimum": 1, "maximum": 65535},
        "height": {"type": "integer", "minimum": 1, "maximum": 65535},
        "sampleRate": {"type": "integer", "minimum": 1, "maximum": 768000},
        "channels": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "assetDecode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "sha256", "status"],
      "properties": {
        "assetId": {"$ref": "editorial://schema/common/v1#/$defs/stableId"},
        "sha256": {"$ref": "editorial://schema/common/v1#/$defs/sha256"},
        "status": {"enum": ["decoded", "failed"]}
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "blocking"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 2000},
        "blocking": {"type": "boolean"}
      }
    }
  }
}
