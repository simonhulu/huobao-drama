{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial://schema/adapter-capabilities/v1",
  "title": "Editorial adapter capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter",
    "supportedProtocolVersions",
    "recipeSchemaVersions",
    "operations",
    "compositionIds",
    "targetProfiles",
    "audioModes",
    "telemetryFields",
    "schemaDigests",
    "environmentIdentity"
  ],
  "properties": {
    "adapter": {"$ref": "#/$defs/adapterIdentity"},
    "supportedProtocolVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"const": 1}
    },
    "recipeSchemaVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"const": "magnates-remotion-recipe-v2"}
    },
    "operations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["capabilities", "build-props", "render", "inspect"]}
    },
    "compositionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
    },
    "targetProfiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/targetProfile"}
    },
    "audioModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["required", "optional", "forbidden"]}
    },
    "telemetryFields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "layerId",
          "frameInterval",
          "boundingBox",
          "opacity",
          "transform",
          "maskBounds",
          "assetId",
          "decodeStatus"
        ]
      }
    },
    "schemaDigests": {"$ref": "#/$defs/hashMap"},
    "environmentIdentity": {"$ref": "#/$defs/environmentIdentity"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "absolutePath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/"},
    "hashMap": {
      "type": "object",
      "x-editorial-map": true,
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 240},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "adapterIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"}
      }
    },
    "targetProfile": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["profileId", "width", "height", "fps"],
          "properties": {
            "profileId": {"const": "youtube-720p"},
            "width": {"const": 1280},
            "height": {"const": 720},
            "fps": {"const": 30}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["profileId", "width", "height", "fps"],
          "properties": {
            "profileId": {"const": "youtube-1080p"},
            "width": {"const": 1920},
            "height": {"const": 1080},
            "fps": {"const": 30}
          }
        }
      ]
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "version": {"type": "string", "minLength": 1, "maxLength": 240},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "environmentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remotion",
        "packageLockHash",
        "browser",
        "fontHashes",
        "nodeVersion",
        "os",
        "architecture",
        "ffmpeg",
        "ffprobe",
        "supportedCodecs",
        "adapterExecutableHash",
        "adapterConfigHash"
      ],
      "properties": {
        "remotion": {"$ref": "#/$defs/toolIdentity"},
        "packageLockHash": {"$ref": "#/$defs/sha256"},
        "browser": {"$ref": "#/$defs/toolIdentity"},
        "fontHashes": {"$ref": "#/$defs/hashMap"},
        "nodeVersion": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+"},
        "os": {"enum": ["darwin", "linux"]},
        "architecture": {"enum": ["arm64", "x64"]},
        "ffmpeg": {"$ref": "#/$defs/toolIdentity"},
        "ffprobe": {"$ref": "#/$defs/toolIdentity"},
        "supportedCodecs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["h264", "aac"]}
        },
        "adapterExecutableHash": {"$ref": "#/$defs/sha256"},
        "adapterConfigHash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
